            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{dni}}\",\n  \"firstNames\": \"Ana\",\n  \"lastNames\": \"Pérez\",\n  \"email\": \"ana.perez@example.com\"\n}",
              "options": {
