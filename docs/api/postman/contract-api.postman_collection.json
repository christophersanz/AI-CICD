    {
      "name": "03 Users",
      "item": [
        {
          "name": "Crear usuario HR → 201 (409 si ya existe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{hrUsername}}\",\n  \"password\": \"{{hrPassword}}\",\n  \"roles\": [\n    \"HR\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creado o ya existente\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) { pm.test(\"La contraseña nunca se devuelve\", () => pm.expect(pm.response.json()).to.not.have.property(\"password\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login HR → 200",
